  "selectionGuidance": {
    "bySceneType": {
      "dialogue_heavy": ["veo31-dialogue"],
      "action_sequence": ["veo31-cinematic", "veo31-timestamp", "sora2-standard"],
      "establishing_shot": ["veo31-cinematic"],
      "creative_stylized": ["veo31-animation"],
      "scene_transition": ["veo31-transition"],
      "complex_choreography": ["veo31-timestamp"]
    },
    "byControl": {
      "precise_timing": ["veo31-timestamp"],
      "artistic_freedom": ["veo31-standard", "veo31-animation"],
      "physics_accuracy": ["sora2-standard"],
      "consistency_priority": ["veo31-timestamp", "veo31-dialogue"]
    },
    "byModel": {
      "veo-3.1-generate-preview": ["veo31-standard", "veo31-timestamp", "veo31-dialogue", "veo31-cinematic", "veo31-animation", "veo31-transition"],
      "veo-3.1-fast-generate-preview": ["veo31-standard", "veo31-dialogue", "veo31-cinematic"],
      "sora-turbo": ["sora2-standard"],
      "unknown": ["generic-versatile"]
    }
  },
  "autoSuggestion": {
    "rules": [
      {
        "condition": "contains_quoted_dialogue",
        "suggested_presets": ["veo31-dialogue", "veo31-timestamp"]
      },
      {
        "condition": "contains_camera_movement_keywords",
        "keywords": ["drone", "aerial", "tracking", "orbiting", "crane"],
        "suggested_presets": ["veo31-cinematic"]
      },
      {
        "condition": "contains_style_keywords",
        "keywords": ["stop-motion", "3D cartoon", "claymation", "whimsical", "surreal"],
        "suggested_presets": ["veo31-animation"]
      },
      {
        "condition": "contains_timestamp_format",
        "pattern": "\\[\\d{2}:\\d{2}-\\d{2}:\\d{2}\\]",
        "suggested_presets": ["veo31-timestamp"]
      },
      {
        "condition": "contains_transition_keywords",
        "keywords": ["transition", "whip pan", "through", "emerges into", "morphs into"],
        "suggested_presets": ["veo31-transition"]
      },
      {
        "condition": "contains_imperial_units",
        "keywords": ["ft", "feet", "ft/s", "mph"],
        "suggested_presets": ["sora2-standard"]
      },
      {
        "condition": "output_format_is",
        "format": "veo3",
        "suggested_presets": ["veo31-standard", "veo31-dialogue", "veo31-cinematic"]
      }
    ]
  }
}
