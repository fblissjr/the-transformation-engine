    {
      "id": "veo31-transition",
      "name": "Veo 3.1 Scene Transition",
      "description": "Specialized schema for smooth transitions between scenes using one of 20 transition patterns.",
      "modelFamily": "veo3",
      "modelVersions": ["veo-3.1-generate-preview", "veo-3.1-fast-generate-preview"],
      "promptingStrategy": "transition",
      "optimalLength": "250-400 words",
      "schemaKeys": [
        {
          "key": "transition_technique",
          "description": "Specific transition pattern (whip_pan, dolly_through, water_immersion, etc.)",
          "required": true,
          "category": "core",
          "enum": ["whip_pan", "push_pull_zoom", "orbital_reveal", "dolly_through", "crane_ascent_descent", "water_immersion", "smoke_fog", "light_flare", "shape_match", "movement_match", "color_match", "time_of_day", "weather_transformation", "seasonal_morph", "reflection_swap", "silhouette_morph", "object_wipe", "rack_focus", "compound_whip_color", "compound_dolly_reflection"]
        },
        {
          "key": "scene_a_state",
          "description": "How Scene A ends - final moment before transition",
          "required": true,
          "category": "core"
        },
        {
          "key": "transition_mechanics",
          "description": "Physical or visual technique driving the transition",
          "required": true,
          "category": "core"
        },
        {
          "key": "scene_b_reveal",
          "description": "How Scene B is revealed - first moment of new scene",
          "required": true,
          "category": "core"
        },
        {
          "key": "visual_bridge",
          "description": "What visual element connects scenes (color, shape, motion, object)",
          "required": true,
          "category": "core"
        },
        {
          "key": "audio_bridge",
          "description": "How audio transforms through transition - critical for continuity",
          "required": true,
          "category": "core"
        },
        {
          "key": "timing",
          "description": "Pacing - seconds for each phase of transition",
          "required": false,
          "category": "enhancement"
        },
        {
          "key": "camera",
          "description": "Camera movement driving or supporting transition",
          "required": true,
          "category": "core"
        }
      ],
      "tags": ["transition", "scene_connection", "continuity", "bridging"],
      "recommendedFor": ["scene_extension", "multi_scene_narratives", "smooth_cuts", "creative_transitions"]
    },
