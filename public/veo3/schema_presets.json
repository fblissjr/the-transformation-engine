{
  "version": "2.0.0",
  "lastUpdated": "2025-11-11",
  "description": "Schema key presets for The Transformation Engine - defining optimal prompt structures for different model families and generation strategies",
  "presets": [
    {
      "id": "veo31-standard",
      "name": "Veo 3.1 Standard (9-Element Continuous)",
      "description": "Continuous narrative with comprehensive detail across all 9 core elements. Best for flowing scenes where artistic interpretation is desired.",
      "modelFamily": "veo3",
      "modelVersions": ["veo-3.1-generate-preview", "veo-3.1-fast-generate-preview"],
      "promptingStrategy": "continuous",
      "optimalLength": "300-400 words",
      "schemaKeys": [
        {
          "key": "visual_description",
          "description": "Complete visual scene description - subjects, environment, composition",
          "required": true,
          "category": "core"
        },
        {
          "key": "temporal_progression",
          "description": "How the scene unfolds over time - action development, changes",
          "required": true,
          "category": "core"
        },
        {
          "key": "camera_movement",
          "description": "Camera type, movement, speed, and choreography",
          "required": true,
          "category": "core"
        },
        {
          "key": "audio_elements",
          "description": "Layered audio - dialogue, SFX, ambient sounds with explicit detail",
          "required": true,
          "category": "core"
        },
        {
          "key": "lighting",
          "description": "Lighting quality, time of day, shadows, atmospheric illumination",
          "required": true,
          "category": "core"
        },
        {
          "key": "color_palette",
          "description": "Dominant colors, saturation, color relationships",
          "required": false,
          "category": "enhancement"
        },
        {
          "key": "subject_detail",
          "description": "Specific details about main subjects - appearance, expression, action",
          "required": true,
          "category": "core"
        },
        {
          "key": "environment_detail",
          "description": "Setting specifics - location type, atmosphere, background elements",
          "required": true,
          "category": "core"
        },
        {
          "key": "mood",
          "description": "Emotional tone, atmosphere, feeling the scene should evoke",
          "required": false,
          "category": "enhancement"
        }
      ],
      "tags": ["default", "versatile", "artistic", "flowing"],
      "recommendedFor": ["general_scenes", "cinematic_realism", "creative_animation"]
    },
    {
      "id": "veo31-timestamp",
      "name": "Veo 3.1 Timestamp (8-Second Segments)",
      "description": "Time-segmented prompting with precise control over each 2-second interval. Best for complex choreography, high consistency, or specific timing requirements.",
      "modelFamily": "veo3",
      "modelVersions": ["veo-3.1-generate-preview", "veo-3.1-fast-generate-preview"],
      "promptingStrategy": "timestamp",
      "optimalLength": "250-350 words",
      "duration": "8s",
      "segmentDuration": "2s",
      "segmentCount": 4,
      "schemaKeys": [
        {
          "key": "timestamp_segments",
          "description": "Array of 4 timed segments [00:00-00:02], [00:02-00:04], [00:04-00:06], [00:06-00:08]",
          "required": true,
          "category": "core",
          "structure": "array"
        },
        {
          "key": "segment_visual",
          "description": "Visual description for each segment",
          "required": true,
          "category": "per_segment"
        },
        {
          "key": "segment_action",
          "description": "Action occurring in each segment",
          "required": true,
          "category": "per_segment"
        },
        {
          "key": "segment_camera",
          "description": "Camera position/movement for each segment",
          "required": true,
          "category": "per_segment"
        },
        {
          "key": "audio_layering",
          "description": "Separate section: primary, secondary, ambient audio across all segments",
          "required": true,
          "category": "core"
        },
        {
          "key": "lighting_progression",
          "description": "How lighting changes or remains constant throughout",
          "required": false,
          "category": "enhancement"
        }
      ],
      "tags": ["precise", "complex", "choreographed", "high_consistency"],
      "recommendedFor": ["complex_action", "dialogue_scenes", "precise_timing"]
    },
